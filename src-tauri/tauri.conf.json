{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screeve",
  "version": "0.1.0",
  "identifier": "com.gesucca.screeve",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screeve",
        "width": 1200,
        "height": 860,
        "minWidth": 520,
        "minHeight": 400,
        "center": true,
        "backgroundColor": "#F4EDDE",
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
